---
import { identity, sections, type Lang } from '../data/site';

// Determine language from the request path. Chinese is the default (no /en
// prefix); English lives under /en/.
const { site } = Astro;
const rawPath = Astro.url.pathname;
const lang: Lang = rawPath.startsWith('/en') ? 'en' : 'zh';
const isEn = lang === 'en';

// Prefix a section path with /en for the English site.
const linkFor = (p: string) => (isEn ? '/en' + p : p);

// Toggle target: from /research -> /en/research, from /en/research -> /research.
const togglePath = () => {
  if (isEn) return rawPath.replace(/^\/en/, '') || '/';
  return rawPath === '/' ? '/en/' : '/en' + rawPath;
};

const name = isEn ? identity.nameEn : identity.nameZh;
const title = isEn ? identity.titleEn : identity.titleZh;
const org = isEn ? identity.orgEn : identity.orgZh;
const tagline = isEn ? identity.taglineEn : identity.taglineZh;

const pageTitle = (Astro.props.title as string | undefined)
  ? `${Astro.props.title} · ${name}`
  : name;
---

<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={tagline} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="https://github.com/ming616.png" />
    <!-- Cross-language alternates -->
    <link rel="alternate" hreflang="zh-CN" href={linkFor(rawPath === '/' ? '/' : rawPath.replace(/^\/en/, ''))} />
    <link rel="alternate" hreflang="en" href={linkFor(rawPath)} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={linkFor('/')}>
          <img class="brand-avatar" src="https://github.com/ming616.png" alt={name} />
          <span class="brand-text">
            <strong>{name}</strong>
            <small>{org}</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {sections.map((s) => (
            <a
              href={linkFor(s.path)}
              class:list={[{ active: rawPath === s.path || (isEn && rawPath === '/en' + s.path) }]}
            >
              {isEn ? s.en : s.zh}
            </a>
          ))}
        </nav>
        <a class="lang-toggle" href={togglePath()} aria-label="Switch language">
          {isEn ? '中文' : 'EN'}
        </a>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          © {new Date().getFullYear()} {name} · {org}
        </p>
        <p class="footer-links">
          <a href={`mailto:${identity.email}`}>{identity.email}</a>
          <a href={`https://github.com/${identity.github}`} target="_blank" rel="noopener">
            GitHub: @{identity.github}
          </a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1f2328;
        --muted: #57606a;
        --accent: #0969da;
        --border: #d0d7de;
        --header-h: 64px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1117;
          --fg: #e6edf3;
          --muted: #8b949e;
          --accent: #58a6ff;
          --border: #30363d;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", Roboto, Helvetica, Arial, sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.7;
      }
      .container {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 20px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(180%) blur(8px);
        border-bottom: 1px solid var(--border);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 16px;
        height: var(--header-h);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--fg);
      }
      .brand:hover { text-decoration: none; }
      .brand-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--border);
      }
      .brand-text { display: flex; flex-direction: column; line-height: 1.25; }
      .brand-text small { color: var(--muted); font-size: 12px; }

      .site-nav {
        display: flex;
        gap: 2px;
        margin-left: auto;
        flex-wrap: nowrap;
        flex: 1 1 auto;
        justify-content: flex-end;
      }
      .site-nav a {
        color: var(--muted);
        padding: 6px 8px;
        border-radius: 6px;
        font-size: 13.5px;
        white-space: nowrap;
      }
      .site-nav a:hover { color: var(--fg); background: color-mix(in srgb, var(--accent) 12%, transparent); text-decoration: none; }
      .site-nav a.active { color: var(--accent); font-weight: 600; }

      .lang-toggle {
        flex: 0 0 auto;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 600;
        color: var(--accent);
      }
      .lang-toggle:hover { text-decoration: none; background: color-mix(in srgb, var(--accent) 10%, transparent); }

      main { min-height: calc(100vh - var(--header-h) - 120px); padding: 48px 0 60px; }
      main h1 { font-size: 30px; margin: 0 0 8px; }
      main h2 { font-size: 22px; margin-top: 36px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
      main h3 { font-size: 18px; margin-top: 24px; }
      main p, main li { color: var(--fg); }
      main .lead { color: var(--muted); font-size: 17px; margin-top: 0; }

      /* Home hero: first heading is the name — make it a hero card. */
      main article, main > div { }
      main h2:first-of-type {
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 4px;
        border: none;
        padding: 0;
      }
      main blockquote {
        margin: 24px 0;
        padding: 16px 20px;
        border-left: 4px solid var(--accent);
        background: color-mix(in srgb, var(--accent) 6%, transparent);
        border-radius: 0 8px 8px 0;
        font-size: 16px;
        color: var(--fg);
      }
      main blockquote p { margin: 0; }

      table { border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 14px; }
      th, td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
      th { background: color-mix(in srgb, var(--accent) 8%, transparent); }

      code {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.9em;
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        padding: 1px 6px;
        border-radius: 4px;
      }
      pre {
        background: color-mix(in srgb, var(--accent) 6%, transparent);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 14px;
        overflow-x: auto;
      }
      pre code { background: none; padding: 0; }

      .site-footer {
        border-top: 1px solid var(--border);
        padding: 24px 0;
        color: var(--muted);
        font-size: 13px;
      }
      .footer-inner { display: flex; flex-direction: column; gap: 6px; }
      .footer-links a { margin-right: 16px; }

      @media (max-width: 720px) {
        .header-inner { flex-wrap: wrap; height: auto; padding: 10px 0; }
        .site-nav { margin-left: 0; order: 3; width: 100%; }
        .brand-text small { display: none; }
      }
    </style>
  </body>
</html>
